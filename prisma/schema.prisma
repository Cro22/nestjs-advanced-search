generator client {
  provider = "prisma-client-js"
}

datasource db {
  // The connection URL lives in prisma.config.ts (Prisma 7). At runtime the
  // PrismaClient receives a pg driver adapter, so no query engine binary is used.
  provider = "postgresql"
}

/// Product is the write model and the source of truth.
/// Elasticsearch is a denormalized read/search projection of this table.
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  description   String
  category      String
  subcategories String[]
  location      String
  // Nullable because coordinates were introduced after the initial data; the
  // seed backfills coordinates for rows that predate geo search.
  latitude      Float?
  longitude     Float?
  price         Decimal  @db.Decimal(12, 2)
  popularity    Int      @default(0)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([location])
  @@index([createdAt])
  @@map("products")
}

/// Transactional outbox for the Elasticsearch projection. Every product write
/// records an entry in the same transaction; a background processor replays
/// unprocessed entries against the index, so a temporary Elasticsearch outage
/// can delay the projection but never lose it.
model OutboxEntry {
  id          String    @id @default(uuid()) @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  /// "upsert" reprojects the product from Postgres; "delete" removes it.
  operation   String
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")
  /// When the entry is eligible for processing again. A worker sets it to a short
  /// lock horizon on claim (so a crashed worker's rows are retried) and to a
  /// backoff delay on failure. Null means "eligible now".
  nextRetryAt DateTime? @map("next_retry_at")
  /// Set once the entry exhausts its retries: a dead letter needing attention.
  failedAt    DateTime? @map("failed_at")
  /// The last failure message, kept to make dead letters diagnosable.
  lastError   String?   @map("last_error")

  @@index([processedAt, failedAt, nextRetryAt, createdAt])
  @@map("outbox_entries")
}
