{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing checks whether the tests actually catch bugs, not just execute lines. Scoped to the pure domain logic, which the unit and property tests cover directly. Run with: npm run test:mutation",
  "packageManager": "npm",
  "testRunner": "jest",
  "jest": {
    "configFile": "package.json"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/shared/domain/money.ts",
    "src/shared/domain/pagination.ts",
    "src/products/domain/**/*.ts",
    "!src/**/*.spec.ts"
  ],
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 60
  },
  "tsconfigFile": "tsconfig.json"
}
