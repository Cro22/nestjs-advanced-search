{
  "info": {
    "name": "Advanced Product Search API",
    "description": "Pre configured requests for the NestJS advanced search API. Set the baseUrl collection variable to point at your environment. It defaults to the local Docker stack at http://localhost:3000/api.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "nextCursor",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health :: readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "description": "Readiness probe. Pings Postgres, Elasticsearch and Redis and returns 503 with a per dependency breakdown when any of them is down."
      }
    },
    {
      "name": "Health :: liveness",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health/liveness",
          "host": ["{{baseUrl}}"],
          "path": ["health", "liveness"]
        },
        "description": "Liveness probe. Only proves the process responds, with no dependency checks."
      }
    },
    {
      "name": "Search :: free text",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?q=laptop",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "q", "value": "laptop" }
          ]
        },
        "description": "Full text search ranked by relevance. Name matches weigh highest, followed by category and subcategories."
      }
    },
    {
      "name": "Search :: typo tolerance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?q=labtop",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "q", "value": "labtop" }
          ]
        },
        "description": "Fuzzy matching still returns laptops for the misspelling labtop, and the suggestions array proposes the corrected term."
      }
    },
    {
      "name": "Search :: filters combined",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?categories=Electronics&subcategories=Laptops&locations=Madrid&minPrice=100&maxPrice=1500",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "categories", "value": "Electronics" },
            { "key": "subcategories", "value": "Laptops" },
            { "key": "locations", "value": "Madrid" },
            { "key": "minPrice", "value": "100" },
            { "key": "maxPrice", "value": "1500" }
          ]
        },
        "description": "Combined faceting. Each returned facet keeps its sibling values so the client can refine further. Filters accept comma separated values or repeated keys."
      }
    },
    {
      "name": "Search :: multi value filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?categories=Electronics,Books&locations=Madrid,Barcelona",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "categories", "value": "Electronics,Books" },
            { "key": "locations", "value": "Madrid,Barcelona" }
          ]
        },
        "description": "A single filter can hold several values. Here products from Electronics or Books, located in Madrid or Barcelona."
      }
    },
    {
      "name": "Search :: sort by popularity",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?sort=popularity&order=desc&page=1&pageSize=10",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "sort", "value": "popularity" },
            { "key": "order", "value": "desc" },
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "10" }
          ]
        },
        "description": "Sort options are relevance, popularity and created_at. Pagination is one based and page size is capped by SEARCH_MAX_PAGE_SIZE."
      }
    },
    {
      "name": "Search :: deep pagination (cursor, page 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const cursor = pm.response.json().meta.nextCursor;",
              "pm.collectionVariables.set('nextCursor', cursor || '');",
              "pm.test('a cursor is returned for a full page', () => pm.expect(cursor).to.be.a('string'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?sort=popularity&pageSize=3",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "sort", "value": "popularity" },
            { "key": "pageSize", "value": "3" }
          ]
        },
        "description": "First page of a deep pagination walk. The test script saves meta.nextCursor into the nextCursor collection variable for the next request."
      }
    },
    {
      "name": "Search :: deep pagination (cursor, next page)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?sort=popularity&pageSize=3&cursor={{nextCursor}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "sort", "value": "popularity" },
            { "key": "pageSize", "value": "3" },
            { "key": "cursor", "value": "{{nextCursor}}" }
          ]
        },
        "description": "Resumes after the previous page using search_after. Run the page 1 request first so nextCursor is populated. Repeat this request to walk the whole result set; meta.nextCursor is null on the last page."
      }
    },
    {
      "name": "Search :: geo radius",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?lat=40.4168&lon=-3.7038&radiusKm=25",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "lat", "value": "40.4168" },
            { "key": "lon", "value": "-3.7038" },
            { "key": "radiusKm", "value": "25" }
          ]
        },
        "description": "Only products within 25 km of central Madrid. The facets honour the radius too."
      }
    },
    {
      "name": "Search :: sort by distance",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?lat=40.4168&lon=-3.7038&sort=distance",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "lat", "value": "40.4168" },
            { "key": "lon", "value": "-3.7038" },
            { "key": "sort", "value": "distance" }
          ]
        },
        "description": "Nearest products first. Each hit carries distanceKm measured from the origin."
      }
    },
    {
      "name": "Search :: sort by newest",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/search?sort=created_at&order=desc",
          "host": ["{{baseUrl}}"],
          "path": ["products", "search"],
          "query": [
            { "key": "sort", "value": "created_at" },
            { "key": "order", "value": "desc" }
          ]
        },
        "description": "Newest products first."
      }
    },
    {
      "name": "Autocomplete",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/autocomplete?q=lap&limit=5",
          "host": ["{{baseUrl}}"],
          "path": ["products", "autocomplete"],
          "query": [
            { "key": "q", "value": "lap" },
            { "key": "limit", "value": "5" }
          ]
        },
        "description": "Prefix suggestions served from Elasticsearch and cached in Redis. Results are collapsed on the exact name so duplicates appear once."
      }
    },
    {
      "name": "Create product",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aurora Laptop Pro\",\n  \"description\": \"A lightweight laptop for everyday use\",\n  \"category\": \"Electronics\",\n  \"subcategories\": [\"Laptops\"],\n  \"location\": \"Madrid\",\n  \"latitude\": 40.4168,\n  \"longitude\": -3.7038,\n  \"price\": 1299.99,\n  \"popularity\": 120\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        },
        "description": "Persists the product in Postgres and projects it into Elasticsearch in the same use case. The new product is immediately searchable."
      }
    },
    {
      "name": "Update product",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aurora Laptop Pro Max\",\n  \"description\": \"A refreshed laptop for everyday use\",\n  \"category\": \"Electronics\",\n  \"subcategories\": [\"Laptops\"],\n  \"location\": \"Barcelona\",\n  \"latitude\": 41.3874,\n  \"longitude\": 2.1686,\n  \"price\": 1399.99\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Full replacement. Keeps the identity, creation date and accumulated popularity. Set the productId collection variable first."
      }
    },
    {
      "name": "Record product view",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}/view",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}", "view"]
        },
        "description": "Increments the live popularity signal used by relevance boosting and popularity sorting. Returns the new value."
      }
    },
    {
      "name": "Delete product",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Removes the product from Postgres and from the search index."
      }
    }
  ]
}
